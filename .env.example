# Copy to server/.env  (never commit the real file)
NODE_ENV=development
PORT=4000
# Transactions need a replica set. See docs/windows-setup.md. Standalone also works (no transactions).
MONGODB_URI=mongodb://127.0.0.1:27017/splitmate?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=tesseract
# Optional free SMTP (e.g. a Gmail app password or Mailtrap free). Leave empty to use the dev outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@splitmate.local
ADMIN_PASSWORD=Admin@12345
